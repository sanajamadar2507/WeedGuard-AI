# WeedGuard AI Backend Configuration Example
# Copy this file to .env and adjust the values for your environment.

# Path to the trained YOLO model (.pt file)
# Local example: C:\Users\sanaj\WeedDetectionProject\runs\detect\train-2\weights\best.pt
# Production/Docker example: ./models/best.pt
MODEL_PATH=C:\Users\sanaj\WeedDetectionProject\runs\detect\train-2\weights\best.pt

# Host and Port configuration
HOST=0.0.0.0
PORT=8000

# Allowed CORS origins (comma-separated or * for development)
# Production example: https://weedguard-ai.vercel.app,http://localhost:5173
CORS_ORIGINS=*
